library(AER)
data(USMacroSWQ)
class(USMacroSWQ)
head(USMacroSWQ)
GDP <- USMacroSWQ[,1]
plot(log(GDP), ylab = 'log GDP', col = 'steelblue')
GDPGR <- 400 * diff(log(GDP))
plot(GDPGR, col = 'steelblue')
library(forecast)
Acf(GDPGR, lag.max - 10)
install.packages('forecast')
library(forecast)
Acf(GDPGR, lag.max - 10)
Acf(GDPGR, lag.max = 10)
library(dynlm)
install.packages('dynlm')
library(dynlm)
AR1 <- dynlm(GDPGR ~ L(GDPGR))
coeftest(AR1, vcov = vcovHC, type = "HC1")
AR2 <- dynlm(GDPGR ~ L(GDPGR) + L(GDPGR,2))
coeftest(AR2, vcov = vcovHC, type = 'HC1')
summary(AR2)$r.squared
summaey(AR2)$sigma
summaery(AR2)$sigma
summary(AR2)$sigma
